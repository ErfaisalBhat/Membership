# Server
PORT=5002
# On the server behind nginx, set HOST=127.0.0.1 (leave empty locally)
HOST=
MONGO_URI=mongodb://127.0.0.1:27017/membership_portal

# Public URL of the website (used in QR codes, emails and CORS)
FRONTEND_URL=http://localhost:5174

# Set to 1 only when running behind a reverse proxy such as nginx
TRUST_PROXY=0

# Organization details (shown on the website, ID cards, receipts and emails)
ORG_NAME=Asiatic Society for Social Science Research
# Prefix of the membership number, e.g. ASSSR-2026-000123
ORG_CODE=ASSSR
CONTACT_EMAIL=membership@asssr.org
CONTACT_PHONE=
CONTACT_ADDRESS=
WEBSITE_URL=

# Optional links shown at the bottom of emails and the website
SOCIAL_FACEBOOK=
SOCIAL_X=
SOCIAL_INSTAGRAM=
SOCIAL_LINKEDIN=
SOCIAL_YOUTUBE=

# Where uploaded documents are stored (never served publicly)
UPLOAD_DIR=uploads

# Email (leave SMTP_HOST empty, or set EMAIL_MODE=log, to only print emails to the console)
EMAIL_MODE=
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
SMTP_FROM=membership@asssr.org
MAIL_FROM_NAME=ASSSR Membership
# Optional images in emails (public https URLs): banner at the top, logo above the signature
EMAIL_HEADER_IMAGE_URL=
EMAIL_LOGO_URL=

# Online payments: test (fake payments, local only), zoho, or empty (switched off)
PAYMENT_PROVIDER=
# Zoho Payments keys — used by backend/payments/providers/zoho.js once you connect it
ZOHO_ACCOUNT_ID=
ZOHO_API_KEY=
ZOHO_CLIENT_ID=
ZOHO_CLIENT_SECRET=
ZOHO_REFRESH_TOKEN=
ZOHO_WEBHOOK_SECRET=
